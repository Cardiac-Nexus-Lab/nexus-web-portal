# Cardiac Nexus Backend Environment Configuration Example
# Copy this file to .env and configure your local settings.

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/cardiac_nexus

# Firebase Project ID (for ID token validation)
FIREBASE_PROJECT_ID=cardiacnexus

# Optional: Path to AI engine (defaults to sibling folder nexus-ai-engine)
# CARDIAC_NEXUS_ENGINE=d:/MainProject/MajorProject/nexus-ai-engine

# Frontend Application URL
REPORT_SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# SMTP Email Verification Settings
# Configure your SMTP server to send registration verification emails & OTPs.
# Examples:
#   Gmail:     SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=True
#              (Note: For Gmail, use an 'App Password' from Google Account > Security)
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey
#   Outlook:   SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_USE_TLS=True
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Cardiac Nexus Security
SMTP_USE_TLS=True
SMTP_USE_SSL=False
