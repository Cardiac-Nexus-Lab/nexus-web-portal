# Backend Database Configuration Example (PostgreSQL Required)
# Set your PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/cardiac_nexus

# Firebase project ID (same as VITE_FIREBASE_PROJECT_ID in the frontend)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to the nexus-ai-engine repository (trained models and cardiac_nexus code)
# Optional; defaults to ../../nexus-ai-engine (the repository next to nexus-web-portal)
CARDIAC_NEXUS_ENGINE=/path/to/nexus-ai-engine
# Optional; shown in the PDF report header once the site is online
REPORT_SITE_URL=
