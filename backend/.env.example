# Copy this file to .env and fill in FIREBASE_PROJECT_ID.

# Database. The local SQLite file needs no setup. For PostgreSQL use, for example,
# postgresql://user:password@localhost:5432/cardiac_nexus
DATABASE_URL=sqlite:///./cardiac_nexus_local.db

# Firebase project ID (same as VITE_FIREBASE_PROJECT_ID in the frontend)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: path to nexus-ai-engine (trained models and cardiac_nexus code).
# Leave commented out when nexus-ai-engine is cloned next to nexus-web-portal.
# CARDIAC_NEXUS_ENGINE=/path/to/nexus-ai-engine

# Optional; shown in the PDF report header once the site is online
REPORT_SITE_URL=
