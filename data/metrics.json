 "augment": [
  {
   "name": "Time shift",
   "p": 0.5,
   "param": "+/-1 s circular roll",
   "why": "Where the 10-second window starts is arbitrary. A shifted window is an equally valid recording of the same patient."
  },
  {
   "name": "Amplitude scale",
   "p": 0.5,
   "param": "0.8-1.2x, all leads together",
   "why": "Gain varies by machine. Scaling leads together preserves the inter-lead relationships where the diagnosis lives."
  },
  {
   "name": "Gaussian noise",
   "p": 0.3,
   "param": "sigma 0.05",
   "why": "Sensor and mains interference."
  },
  {
   "name": "Baseline wander",
   "p": 0.3,
   "param": "0.15 mV, 0.15-0.6 Hz, per lead",
   "why": "Respiration and electrode movement."
  },
  {
   "name": "Lead dropout",
   "p": 0.2,
   "param": "1-2 leads zeroed",
   "why": "Electrodes detach. This teaches the model not to depend on any single lead."
  }
 ],
 "augment_rejected": [
  {
   "name": "Reverse time",
   "why": "A backwards ECG is not a recording of anything. It would teach an invariance that is clinically false."
  },
  {
   "name": "Permute leads",
   "why": "Each lead is a fixed viewing angle. Swapping them destroys the geometry that localises an infarct."
  },
  {
   "name": "Flip amplitude",
   "why": "An inverted T wave is a different finding, not the same recording seen differently."
  }
 ],
